							"loader": "fabric",
							"id": "k8bas_skyblock_utility",
							"version": "1.3.1+26.2",
							"name": "K8bas Skyblock Utility",
							"description": "A modular client-side toolkit for Hypixel SkyBlock: rule-based outlines for the mobs and NPCs you can see, island-aware waypoints with beacon beams for NPCs at fixed spots, a searchable settings screen with mob and NPC lists that stays sharp at every GUI scale, and updates from GitHub that install when you quit, after you confirm them. For mining: a Glacite Mineshaft entry alert with your corpse keys, possible corpse spots and an Organ Donor ding hint. For fishing: hotspot rings with a warning when yours disappears, and a bobber that floats smoothly. Display only: no gameplay automation, and no packet is cancelled or changed. Not affiliated with or endorsed by Hypixel.",
							"minecraft": "~26.2",
							"environment": "client",
							"depends": [
								"fabricloader",
