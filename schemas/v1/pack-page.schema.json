{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/fatlard1993/ender-index/main/schemas/v1/pack-page.schema.json",
	"title": "An ender-index pack page",
	"description": "data/pack-pages/<owner>/<repo>.json: a pack summary, as in packs.json, with every mod it names. Fields may be added at any time.",
	"type": "object",
	"required": [
		"repo",
		"host",
		"name",
		"pushed",
		"formats",
		"minecraft",
		"loader",
		"count",
		"matched",
		"faces",
		"fromModrinth",
		"unsourced",
		"missing",
		"install",
		"mods"
	],
	"properties": {
		"repo": {
			"type": "string",
			"description": "owner/repo, or the gist id for a gist"
		},
		"host": {
			"type": "string",
			"description": "Where the pack is kept: github or gist so far; more may be added"
		},
		"name": {
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"stars": {
			"type": "number"
		},
		"pushed": {
			"type": "string"
		},
		"formats": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "The formats the pack is in: ender, packwiz, mrpack"
		},
		"minecraft": {
			"type": "string"
		},
		"loader": {
			"type": "string"
		},
		"version": {
			"type": "string"
		},
		"author": {
			"type": "string"
		},
		"loaderVersion": {
			"type": "string"
		},
		"memory": {
			"type": "number"
		},
		"servers": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "address"],
				"properties": {
					"name": {
						"type": "string"
					},
					"address": {
						"type": "string"
					}
				}
			}
		},
		"extras": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["kind", "name"],
				"properties": {
					"kind": {
						"type": "string",
						"description": "resourcepacks or shaderpacks; more may be added"
					},
					"name": {
						"type": "string"
					},
					"optional": {
						"type": "boolean"
					},
					"description": {
						"type": "string"
					},
					"default": {
						"type": "boolean",
						"description": "On until a player turns it off"
					}
				}
			}
		},
		"count": {
			"type": "integer",
			"description": "How many mods it names"
		},
		"matched": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "The index's keys for the mods it names that the index has"
		},
		"faces": {
			"type": "array"
		},
		"fromModrinth": {
			"type": "integer"
		},
		"unsourced": {
			"type": "integer"
		},
		"missing": {
			"type": "integer"
		},
		"install": {
			"type": "string",
			"description": "The ender command that makes an instance of it"
		},
		"mods": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"key": {
						"type": "string",
						"description": "The index's key for the mod, when the index has it"
					},
					"file": {
						"type": "string"
					},
					"jar": {
						"type": "string",
						"description": "Where its jar comes from when the index has not got it: modrinth, link or none; more may be added"
					},
					"modrinth": {
						"type": "string"
					},
					"source": {
						"type": "string"
					},
					"optional": {
						"type": "boolean"
					},
					"description": {
						"type": "string"
					},
					"default": {
						"type": "boolean",
						"description": "On until a player turns it off"
					}
				}
			}
		}
	}
}
