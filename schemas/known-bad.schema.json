{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/fatlard1993/ender-index/main/schemas/known-bad.schema.json",
	"title": "Jars confirmed to do harm",
	"description": "data/known-bad.json. A consumer must refuse to install any jar whose sha256 is listed, wherever it came from.",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["sha256", "reason"],
		"properties": {
			"sha256": {
				"type": "string",
				"pattern": "^[0-9a-f]{64}$"
			},
			"reason": {
				"type": "string"
			}
		}
	}
}
