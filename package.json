{
	"name": "ender-index",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Minecraft mods found where their source lives, read from their own jars and scanned nightly",
	"author": "fatlard1993",
	"license": "MIT",
	"scripts": {
		"discover": "bun src/discover.js",
		"crawl": "bun src/crawl.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/ender-index.git"
	},
	"dependencies": {
		"ender-launcher": "file:../ender-launcher"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@vanilla-bean/components": "^7.0.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"prettier": "3.5.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
