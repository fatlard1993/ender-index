{
	"name": "ender-index",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Minecraft mods found where their source lives, read from their own jars and scanned nightly",
	"author": "fatlard1993",
	"license": "MIT",
	"scripts": {
		"prepare": "bun run prepare:githooks",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"discover": "bun src/discover.js",
		"crawl": "bun src/crawl.js",
		"lists": "bun src/lists.js",
		"triage": "bun src/triage.js",
		"sources": "bun src/sources.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"build:site": "bun scripts/buildSite.js",
		"local": "bun run build:site && NODE_ENV=production bun scripts/local.js",
		"local:dev": "NODE_ENV=development bun --hot scripts/local.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/ender-index.git"
	},
	"dependencies": {
		"ender-launcher": "file:../ender-launcher",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^21.0.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@vanilla-bean/components": "^7.0.3",
		"bun-types": "^1.3.14",
		"dompurify": "3.2.6",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"happy-dom": "^21.0.4",
		"marked": "15.0.12",
		"prettier": "3.5.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	]
}
